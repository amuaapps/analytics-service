{
  "name": "@amuaapps/analytics-service",
  "version": "1.0.0",
  "description": "Analytics microservice for collecting, processing, and querying analytics events",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "NODE_OPTIONS='--loader ts-node/esm' node src/local-server.ts",
    "dev:watch": "NODE_OPTIONS='--loader ts-node/esm' nodemon --watch src --ext ts --exec node src/local-server.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --ci --testPathIgnorePatterns=post-deploy",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration --testPathIgnorePatterns=post-deploy",
    "test:post-deploy": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration/post-deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm test",
    "prepare": "husky install || true"
  },
  "keywords": [
    "analytics",
    "microservice",
    "serverless",
    "typescript",
    "aws",
    "azure"
  ],
  "author": "Amua Apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amuaapps/analytics-service.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.965.0",
    "@aws-sdk/client-s3": "^3.965.0",
    "@aws-sdk/client-secrets-manager": "^3.966.0",
    "@aws-sdk/client-sqs": "^3.965.0",
    "@aws-sdk/util-dynamodb": "^3.965.0",
    "@azure/cosmos": "^4.9.0",
    "@azure/functions": "^4.0.0",
    "@azure/storage-blob": "^12.29.1",
    "@azure/storage-queue": "^12.28.1",
    "express": "^4.18.2",
    "pino": "^8.17.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.130",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.54.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "undici": "^6.23.0",
    "fast-xml-parser": "^5.3.4"
  }
}
