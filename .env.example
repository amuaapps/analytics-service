# Environment
NODE_ENV=development

# Service Configuration
ANALYTICS_WRITE_KEY=your-secret-write-key-here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=info

# AWS Configuration (if deploying to AWS)
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=analytics_events
S3_RAW_BUCKET_NAME=analytics-raw-events
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/analytics-events

# Azure Configuration (if deploying to Azure)
AZURE_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
AZURE_COSMOS_KEY=your-cosmos-key-here
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccountname;AccountKey=youraccountkey;EndpointSuffix=core.windows.net
AZURE_QUEUE_NAME=analytics-events
