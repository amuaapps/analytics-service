# =============================================================================
# Analytics Service - Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# For local development, you can use in-memory implementations (no cloud setup needed)

# -----------------------------------------------------------------------------
# Service Configuration
# -----------------------------------------------------------------------------
SERVICE_NAME=analytics-service
NODE_ENV=development
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Write key for authenticating ingestion requests (comma-separated for multiple keys)
ANALYTICS_WRITE_KEY=local-dev-key-12345

# CORS allowed origins (comma-separated, use * for development only)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# Request Limits
# -----------------------------------------------------------------------------
MAX_PAYLOAD_SIZE_BYTES=1048576
MAX_EVENTS_PER_BATCH=100
MIN_EVENTS_PER_BATCH=1
MAX_PROPERTY_DEPTH=10
MAX_KEYS_PER_LEVEL=50
MAX_STRING_LENGTH=2048
MAX_ARRAY_LENGTH=100
MAX_QUERY_WINDOW_DAYS=31
DEFAULT_QUERY_LIMIT=50
MAX_QUERY_LIMIT=200

# -----------------------------------------------------------------------------
# Cloud Provider Configuration
# -----------------------------------------------------------------------------
# Options: 'aws', 'azure', or leave empty for in-memory (local development)
# For local development, leave this empty or comment out to use in-memory implementations
# CLOUD_PROVIDER=

# -----------------------------------------------------------------------------
# AWS Configuration (only required if CLOUD_PROVIDER=aws)
# -----------------------------------------------------------------------------
# AWS_REGION=us-east-1
# AWS_DYNAMODB_TABLE_NAME=analytics-events
# AWS_S3_RAW_BUCKET_NAME=analytics-raw-events
# AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/analytics-queue

# AWS credentials (use AWS CLI profile or IAM role in production)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# -----------------------------------------------------------------------------
# Azure Configuration (only required if CLOUD_PROVIDER=azure)
# -----------------------------------------------------------------------------
# AZURE_COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
# AZURE_COSMOS_KEY=your-cosmos-key-here
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net
# AZURE_QUEUE_NAME=analytics-queue

# -----------------------------------------------------------------------------
# Local Development Notes
# -----------------------------------------------------------------------------
# For local development without cloud dependencies:
# 1. Leave CLOUD_PROVIDER empty or commented out
# 2. The service will use in-memory implementations for storage and queuing
# 3. Run: npm run dev
# 4. Run tests: npm test
# 5. All tests use in-memory implementations by default (no external calls)
